      "video": {
        "type": "webview",
        "script": "(function(){try{var onRed=location.host.indexOf('dm.dalvdm.cc')!==-1;function gv(n){try{if(typeof window[n]!=='undefined'&&window[n]&&window[n].url)return window[n].url;}catch(e){}return null;}function tok(){var names=['player_aaaa','player_data','player'];for(var i=0;i<names.length;i++){var g=gv(names[i]);if(g)return g;}var html=document.documentElement.outerHTML;for(var i2=0;i2<names.length;i2++){var idx=html.indexOf(names[i2]);while(idx!==-1){var ub=html.indexOf('\"url\":\"',idx);if(ub!==-1){var st=ub+7;var en=html.indexOf('\"',st);if(en!==-1){var val=html.substring(st,en);if(val.indexOf('DL-')===0||val.toUpperCase().indexOf('%44%4C')===0)return val;}}idx=html.indexOf(names[i2],idx+1);}}return null;}function dec(x){if(typeof decrypt!=='function')return null;var c=[x];try{c.push(decodeURIComponent(x));}catch(e){}c.push(location.href);for(var i=0;i<c.length;i++){try{var r=decrypt(c[i]);if(r&&typeof r==='string'&&r.indexOf('http')===0)return r;if(r&&typeof r==='object'){for(var k in r){if((''+r[k]).indexOf('http')===0)return r[k];}}}catch(e){}}return null;}if(!onRed){var t=tok();if(t){try{t=decodeURIComponent(t);}catch(e){}var d=dec(t);if(d)return d;return 'webview:https://dm.dalvdm.cc/?url='+encodeURIComponent(t);}}var up=null;try{up=new URLSearchParams(location.search).get('url');}catch(e){}if(up){var d2=dec(up);if(d2)return d2;}var v=document.querySelector('video');if(v&&v.src&&(''+v.src).indexOf('http')===0)return v.src;var s=document.querySelector('source[src]');if(s&&s.src)return s.src;return '';}catch(e){return '';}})()"
      }
