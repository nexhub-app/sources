  "routes": {
    "latest": {
      "url": "/index.php/ajax/data/?mid=1&page={page}&limit=20",
      "method": "get",
      "responseType": "json"
    },
    "search": {
      "url": "/index.php/ajax/suggest?mid=1&wd={keyword}&limit=50",
      "method": "get",
      "responseType": "json"
    },
    "detail": {
      "url": "/index.php/vod/detail/id/{id}.html",
      "method": "get",
      "responseType": "html"
    },
    "category": {
      "url": "/index.php/vod/show/id/{category}.html?class={class}&area={area}&year={year}&letter={letter}&by={by}&page={page}",
      "method": "get",
      "responseType": "html"
    },
    "episodes": {
      "url": "/index.php/vod/detail/id/{id}.html",
      "method": "get",
      "responseType": "html"
    },
    "video": {
      "url": "{url}",
      "method": "get",
      "responseType": "html"
    },
    "week": {
      "url": "/index.php/ajax/data/?mid=1&page={page}&limit=20",
      "method": "get",
      "responseType": "json"
    }
  },
  "selectors": {
    "list": "$.list",
    "id": "$.vod_id",
    "title": "$.vod_name",
    "cover": "$.vod_pic",
    "status": "$.vod_remarks",
    "tags": "$.vod_class",
    "year": "$.vod_year",
    "updatedAt": "$.vod_time",
    "detail": {
      "title": "div.detail-box h1",
      "cover": "div.vod-detailll img@data-original",
      "description": "div.vod-content",
      "director": "div.detail-box div.director:nth-of-type(1)",
      "actors": "div.detail-box div.director:nth-of-type(2)",
      "tags": "div.detail-box a.tag"
    },
    "category": {
      "list": "div.myui-vodbox-content",
      "id": "substring-before(substring-after(a/@href,'/vod/detail/id/'),'.html')",
      "title": ".info-title-box .title",
      "cover": "img@src",
      "detailUrl": "a@href",
      "status": ".tag-box .tag",
      "actors": ".info-roles",
      "description": ".info-intro p"
    },
    "episodes": {
      "lineList": "div.tab-pane.lists-box",
      "lineName": "ul.nav li a",
      "list": "div.listitem a"
    },
    "video": "//video/@src",
    "search": {
      "list": "$.list",
