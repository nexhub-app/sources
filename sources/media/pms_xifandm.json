{
  "id": "pms_xifandm",
  "version": 4,
  "name": "稀饭动漫",
  "type": "animeSource",
  "responseType": "json",
  "useWebview": false,
  "site": {
    "domain": "api.xifanacg.com",
    "baseUrl": "https://api.xifanacg.com",
    "headers": {
      "apikey": "sb_publishable_OBIVAWACIX6lPXrO98_z24_HcsmalkA",
      "Authorization": "Bearer sb_publishable_OBIVAWACIX6lPXrO98_z24_HcsmalkA"
    },
    "mirrors": [
      {
        "name": "主站",
        "domain": "api.xifanacg.com",
        "baseUrl": "https://api.xifanacg.com"
      }
    ]
  },
  "parser": {
    "type": "jsonpath"
  },
  "routes": {
    "latest": {
      "url": "/rest/v1/animes?select=id,title,cover_url,remarks,release_year,updated_at&is_published=eq.true&order=updated_at.desc&limit=20&offset={page*20-20}",
      "method": "get",
      "responseType": "json"
    },
    "search": {
      "url": "/rest/v1/animes?select=id,title,cover_url,remarks&is_published=eq.true&or=(search_title.ilike.*{keyword}*,pinyin_search.ilike.*{keyword}*,search_author.ilike.*{keyword}*)&order=view_count.desc&limit=30&offset={page*30-30}",
      "method": "get",
      "responseType": "json"
    },
    "detail": {
      "url": "/rest/v1/animes?select=id,title,cover_url,description,director,release_year,remarks,is_finished,total_episodes&is_published=eq.true&id=eq.{id}",
      "method": "get",
      "responseType": "json"
    },
    "episodes": {
      "url": "/rest/v1/episodes?select=id,episode_number,title&anime_id=eq.{id}&kind=eq.main&order=episode_number.asc&limit=500",
      "method": "get",
      "responseType": "json"
    },
    "video": {
      "url": "/functions/v1/issue-web-playback",
      "method": "post",
      "body": "{\"action\":\"fallback\",\"episode_id\":{url}}",
      "headers": {
        "Content-Type": "application/json"
      },
      "responseType": "json"
    },
    "category": {
      "url": "/rest/v1/animes?select=id,title,cover_url,remarks,release_year,updated_at&is_published=eq.true&type_id=eq.{category}&meta_tags={class?}&release_year={year?}&order={by}&limit=24&offset={page*24-24}",
      "method": "get",
      "responseType": "json"
    }
  },
  "selectors": {
    "latest": {
      "list": "$",
      "id": "$.id",
      "title": "$.title",
      "cover": "$.cover_url",
      "status": "$.remarks",
      "year": "$.release_year",
      "updatedAt": "$.updated_at"
    },
    "search": {
      "list": "$",
      "id": "$.id",
      "title": "$.title",
      "cover": "$.cover_url",
      "status": "$.remarks"
    },
    "category": {
      "list": "$",
      "id": "$.id",
      "title": "$.title",
      "cover": "$.cover_url",
      "status": "$.remarks",
      "year": "$.release_year",
      "updatedAt": "$.updated_at"
    },
    "detail": {
      "title": "$[0].title",
      "cover": "$[0].cover_url",
      "description": "$[0].description",
      "director": "$[0].director",
      "year": "$[0].release_year",
      "status": "$[0].remarks"
    },
    "episodes": {
      "list": "$",
      "id": "$.id",
      "title": "$.title",
      "url": "$.id",
      "number": "$.episode_number"
    },
    "video": "$.url"
  },
  "category": {
    "dynamicCategories": false,
    "categoryEntries": [
      {
        "id": "1",
        "title": "连载新番"
      },
      {
        "id": "2",
        "title": "完结旧番"
      },
      {
        "id": "3",
        "title": "剧场版"
      },
      {
        "id": "4",
        "title": "美漫"
      }
    ]
  },
  "homeSections": [
    {
      "id": "latest",
      "title": "最新更新",
      "route": "latest",
      "style": "grid",
      "limit": 18,
      "more": true
    }
  ],
  "stealthMode": true,
  "antiHotlinking": {
    "referer": "https://next.xifanacg.com"
  },
  "ageRating": "general",
  "enabled": true,
  "enabledExplore": true,
  "isHidden": false,
  "migrationMessage": "v4：站点由 MacCMS（anime.xifanacg.com）整体迁移至 Next.js 新站（next.xifanacg.com），旧接口全部 301 失效。数据源改走新站 Supabase 后端（api.xifanacg.com，PostgREST 公开表 animes/episodes），播放地址由 issue-web-playback 接口匿名签发（明文 MP4 直链，多线路自动择优）。分类改为 连载新番/完结旧番/剧场版/美漫（新 type_id 1-4），筛选（类型/年份/排序）改走 meta_tags/release_year/order 过滤。v3：新增分类与筛选（走 ds_api vod 接口）。v2：搜索改走 suggest 联想接口。",
