{
  "id": "pms_akianime",
  "version": 6,
  "name": "Akianime",
  "type": "animeSource",
  "responseType": "html",
  "useWebview": false,
  "site": {
    "domain": "www.moefun.cc",
    "baseUrl": "https://www.moefun.cc",
    "mirrors": [
      {
        "name": "主站",
        "domain": "www.moefun.cc",
        "baseUrl": "https://www.moefun.cc"
      },
      {
        "name": "镜像",
        "domain": "www.akianime.cc",
        "baseUrl": "https://www.akianime.cc"
      }
    ]
  },
  "routes": {
    "latest": {
      "url": "/",
      "method": "get",
      "responseType": "html"
    },
    "search": {
      "url": "/bgmsearch/-------------.html?wd={keyword}",
      "method": "get",
      "responseType": "html"
    },
    "detail": {
      "url": "{detailUrl}",
      "method": "get",
      "responseType": "html"
    },
    "episodes": {
      "url": "{detailUrl}",
      "method": "get",
      "responseType": "html"
    },
    "video": {
      "url": "{url}",
      "method": "get",
      "responseType": "html"
    },
    "category": {
      "url": "/index.php/ds_api/vod?type={category}&class={class}&area=&year={year}&lang=&version=&state=&letter={letter}&time=&level=0&weekday=&by={sort}&page={page}",
      "method": "post",
      "responseType": "json"
    }
  },
  "selectors": {
    "list": "div.public-list-box",
    "id": "a.public-list-exp@href",
    "title": "a.time-title@title",
    "cover": "img@data-src",
    "search": {
      "list": "div.vod-detail",
      "id": "a[href*='/bgmdetail/']@href",
      "title": "h3.slide-info-title",
      "cover": "img@data-src"
    },
    "category": {
      "list": "$.list[*]",
      "id": "$.url",
      "title": "$.vod_name",
      "cover": "$.vod_pic",
      "detailUrl": "$.url",
      "description": "$.vod_blurb",
      "status": "$.vod_remarks"
    },
    "detail": {
      "title": "h3.slide-info-title",
      "cover": "div.detail-pic img@data-src",
      "description": "div.detail-content-desc, p.desc",
      "tags": "//li[em[contains(text(),'类型：')]]/a",
      "director": "//li[em[contains(text(),'导演：')]]/a",
      "year": "substring-after(//li[em[contains(text(),'年份：')]],'年份：')"
    },
    "episodes": {
      "lineList": "div.anthology-list-box",
      "lineName": "div.anthology-tab .swiper-slide",
      "list": "ul.anthology-list-play li a"
    }
  },
