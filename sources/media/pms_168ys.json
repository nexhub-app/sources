        "type": "script",
        "function": "parseVideo",
        "script": "// 播放页内嵌 player_aaaa 配置对象（url/encrypt），encrypt=1 走 URL 解码、=2 走 base64 + URL 解码；\n// 配置缺失时回退到页面里第一个 m3u8/mp4 明文地址。\nfunction _xfAtob(s){var k='ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/';var o='';s=String(s).replace(/[^A-Za-z0-9+\\/=]/g,'').replace(/=+$/,'');for(var i=0;i<s.length;i+=4){var a=k.indexOf(s.charAt(i)),b=k.indexOf(s.charAt(i+1)),c=i+2<s.length?k.indexOf(s.charAt(i+2)):-1,d=i+3<s.length?k.indexOf(s.charAt(i+3)):-1;if(c<0)c=0;if(d<0)d=0;o+=String.fromCharCode((a<<2)|(b>>4));if(i+2<s.length)o+=String.fromCharCode(((b&15)<<4)|(c>>2));if(i+3<s.length)o+=String.fromCharCode(((c&3)<<6)|d);}return o;}\nfunction _xfPlayer(html){var i=html.indexOf('player_aaaa');if(i<0)return '';var k=html.indexOf('{',i);if(k<0)return '';var d=0,e=-1;for(var j=k;j<html.length;j++){var c=html.charAt(j);if(c=='{')d++;else if(c=='}'){d--;if(d==0){e=j+1;break;}}}if(e<0)return '';var cfg=JSON.parse(html.substring(k,e));var u=cfg.url||'';var enc=cfg.encrypt||0;if(enc==2){u=_xfAtob(u);try{u=decodeURIComponent(u);}catch(x){}}else if(enc==1){try{u=decodeURIComponent(u);}catch(x){}}return u;}\nfunction parseVideo(html){try{var u=_xfPlayer(html);if(u&&u.indexOf('http')===0)return u;var m=html.match(/https?:\\/\\/[^\"'\\s,]+?\\.(?:m3u8|mp4)[^\"'\\s,]*/);if(m)return m[0];return '';}catch(e){return '';}}"
      }
    }
