{
  "id": "pms_ios_mifun",
  "version": 6,
  "name": "MiFun",
  "type": "animeSource",
  "responseType": "html",
  "useWebview": false,
  "site": {
    "domain": "ios.mifun.org",
    "baseUrl": "https://ios.mifun.org",
    "mirrors": [
      {
        "name": "主站",
        "domain": "ios.mifun.org",
        "baseUrl": "https://ios.mifun.org"
      }
    ]
  },
  "routes": {
    "latest": {
      "url": "/index.php/ajax/data?mid=1&page={page}&limit=20",
      "method": "get",
      "responseType": "json"
    },
    "category": {
      "url": "/vodshow/{category}/?page={page}&class={class?}&area={area?}&lang={lang?}&year={year?}&letter={letter?}&by={by?}",
      "method": "get",
      "responseType": "html"
    },
    "search": {
      "url": "/vodsearch/page/{page}/wd/{keyword}/",
      "method": "get",
      "responseType": "html"
    },
    "detail": {
      "url": "/voddetail/{id}/",
      "method": "get",
      "responseType": "html"
    },
    "episodes": {
      "url": "/voddetail/{id}/",
      "method": "get",
      "responseType": "html"
    },
    "video": {
      "url": "{url}",
      "method": "get",
      "responseType": "html"
    }
  },
  "selectors": {
    "latest": {
      "list": "$.list",
      "id": "$.vod_id",
      "title": "$.vod_name",
      "cover": "$.vod_pic",
      "description": "$.vod_blurb",
      "updatedAt": "$.vod_time"
    },
    "category": {
      "list": "ul.hl-vod-list li.hl-list-item",
      "id": "substring-before(substring-after(.//a[contains(@class,'hl-item-thumb')]/@href, '/voddetail/'), '/')",
      "title": "a.hl-item-thumb@title, .hl-item-title a@text",
      "cover": "a.hl-item-thumb@data-original, a.hl-item-thumb@src"
    },
    "search": {
      "list": "ul.hl-one-list li.hl-list-item",
      "id": "substring-before(substring-after(.//a[contains(@class,'hl-item-thumb')]/@href, '/voddetail/'), '/')",
      "title": "a.hl-item-thumb@title, .hl-item-title a@text",
      "cover": "a.hl-item-thumb@data-original, a.hl-item-thumb@src",
      "description": "p.hl-item-sub",
      "status": ".hl-pic-text .remarks"
    },
    "detail": {
      "title": "h2.hl-dc-title",
      "cover": "div.hl-dc-pic .hl-item-thumb@data-original, div.hl-dc-pic img@data-original, div.hl-dc-pic img@src",
      "description": "span.hl-content-text",
      "director": "//em[contains(text(),'导演')]/following-sibling::a/text()",
      "actors": "//em[contains(text(),'主演')]/following-sibling::a/text(), //em[contains(text(),'演员')]/following-sibling::a/text()",
      "year": "substring-after(//li[em[contains(text(),'年份')]], '：')",
      "status": "//em[contains(text(),'状态')]/following-sibling::span/text()",
      "tags": "//em[contains(text(),'类型')]/following-sibling::a/text()"
    },
    "episodes": {
      "lineList": "div.hl-tabs-box",
      "lineName": "div.hl-plays-from a.hl-tabs-btn",
      "list": "ul.hl-plays-list li a"
    }
  },
  "parser": {
    "type": "hybrid",
    "overrides": {
      "latest": {
        "type": "builtin"
      },
      "search": {
        "type": "builtin"
      },
      "detail": {
        "type": "builtin"
      },
      "episodes": {
        "type": "builtin"
      },
      "video": {
        "type": "script",
        "function": "mfVideo",
        "script": "function atob(s){var k='ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/';var o='';s=String(s).replace(/[^A-Za-z0-9+\\/=]/g,'').replace(/=+$/,'');for(var i=0;i<s.length;i+=4){var a=k.indexOf(s.charAt(i)),b=k.indexOf(s.charAt(i+1)),c=i+2<s.length?k.indexOf(s.charAt(i+2)):-1,d=i+3<s.length?k.indexOf(s.charAt(i+3)):-1;if(c<0)c=0;if(d<0)d=0;o+=String.fromCharCode((a<<2)|(b>>4));if(i+2<s.length)o+=String.fromCharCode(((b&15)<<4)|(c>>2));if(i+3<s.length)o+=String.fromCharCode(((c&3)<<6)|d);}return o;}var __mfTok;\nfunction mfType(u){var lu=String(u).toLowerCase();if(lu.indexOf('.m3u8')>=0||lu.indexOf('/m3u8/')>=0)return 'm3u8';return 'mp4';}\nfunction mfUnpack(html){try{var i=html.indexOf('player_aaaa');if(i<0)return '';var k=html.indexOf('{',i);if(k<0)return '';var d=0,end=-1;for(var j=k;j<html.length;j++){var c=html.charAt(j);if(c=='{')d++;else if(c=='}'){d--;if(d==0){end=j+1;break;}}}if(end<0)return '';var cfg=JSON.parse(html.substring(k,end));var u=cfg.url||'';var enc=cfg.encrypt||0;if(enc==2){u=atob(u);try{u=decodeURIComponent(u);}catch(e){}}else if(enc==1){u=decodeURIComponent(u);}return u;}catch(e){return '';}}\nfunction mfVideo(html){var tok=mfUnpack(html);if(!tok)return '';if(tok.indexOf('http')===0)return {url:tok,type:mfType(tok)};__mfTok=tok;return {__meta:true,__fetchUrl:'https://data.m3u8.in/player/?url='+encodeURIComponent(tok),__fetchResponseType:'text',__fetchHeaders:{'Referer':'https://ios.mifun.org/'},__processor:'mfPlayer'};}\nfunction mfPlayer(text){try{var i=text.indexOf('const Sign');if(i<0)i=text.indexOf('const  Sign');if(i<0)return '';var a=text.indexOf('\"',i);var b=text.indexOf('\"',a+1);if(a<0||b<0)return '';var sign=text.substring(a+1,b);return {__meta:true,__fetchUrl:'https://data.m3u8.in/player/api.php?url='+encodeURIComponent(__mfTok)+'&sign='+encodeURIComponent(sign),__fetchResponseType:'text',__fetchHeaders:{'X-Requested-With':'XMLHttpRequest','Referer':'https://data.m3u8.in/player/?url='+encodeURIComponent(__mfTok)},__processor:'mfApi'};}catch(e){return '';}}\nfunction mfApi(text){try{var j=JSON.parse(text);var u=j.url||j.data&&j.data.url||'';if(!u)return '';return {url:u,type:mfType(u)};}catch(e){return '';}}"
      }
    }
  },
