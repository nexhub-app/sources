{
  "id": "pms_xifandm",
  "version": 3,
  "name": "稀饭动漫",
  "type": "animeSource",
  "responseType": "json",
  "useWebview": false,
  "site": {
    "domain": "anime.xifanacg.com",
    "baseUrl": "https://anime.xifanacg.com",
    "mirrors": [
      {
        "name": "主站",
        "domain": "anime.xifanacg.com",
        "baseUrl": "https://anime.xifanacg.com"
      }
    ]
  },
  "parser": {
    "type": "hybrid",
    "overrides": {
      "latest": {
        "type": "builtin"
      },
      "search": {
        "type": "builtin"
      },
      "detail": {
        "type": "builtin"
      },
      "episodes": {
        "type": "builtin"
      },
      "video": {
        "type": "script",
        "function": "parseVideo",
        "script": "function parseVideo(html){try{var i=html.indexOf('player_aaaa');if(i<0)i=0;var k=i;while(k<html.length){var ub=html.indexOf('\"url\":\"',k);if(ub<0)break;var st=ub+7;var en=html.indexOf('\"',st);if(en<0)break;var u=html.substring(st,en).split(String.fromCharCode(92)).join('');if(u.indexOf('http')===0)return u;k=ub+7;}var j=html.indexOf('<video');if(j<0)j=html.indexOf('<source');if(j>=0){var sa=html.indexOf('src=\"',j);if(sa>=0){var ea=html.indexOf('\"',sa+5);if(ea>sa)return html.substring(sa+5,ea);}}return '';}catch(e){return '';}}"
      }
    }
  },
  "routes": {
    "latest": {
      "url": "/index.php/ajax/data/?mid=1&page={page}&limit=20",
      "method": "get",
      "responseType": "json"
    },
    "search": {
      "url": "/index.php/ajax/suggest?mid=1&wd={keyword}&limit=50",
      "method": "get",
      "responseType": "json"
    },
    "detail": {
      "url": "/bangumi/{id}.html",
      "method": "get",
      "responseType": "html"
    },
    "episodes": {
      "url": "/bangumi/{id}.html",
      "method": "get",
      "responseType": "html"
    },
    "video": {
      "url": "{url}",
      "method": "get",
      "responseType": "html"
    },
    "category": {
      "url": "/index.php/ds_api/vod?type={category}&class={class}&year={year}&page={page}&level=0&by={by}",
      "method": "post",
      "responseType": "json"
    }
  },
  "selectors": {
    "list": "$.list",
    "id": "$.vod_id",
    "title": "$.vod_name",
    "cover": "$.vod_pic",
    "status": "$.vod_remarks",
    "tags": "$.vod_class",
    "year": "$.vod_year",
    "updatedAt": "$.vod_time",
    "detail": {
      "title": "h3.slide-info-title",
      "cover": "div.detail-pic img@data-src",
      "description": "div#height_limit",
      "director": "a[href*='/search/director/']",
      "actors": "a[href*='/search/actor/']",
      "year": "a[href*='/search/year/']",
      "tags": "a[href*='/search/class/']",
      "status": "span.slide-info-remarks"
    },
    "episodes": {
      "lineList": "div.anthology-list-box",
      "lineName": ".anthology-tab a",
      "list": "ul.anthology-list-play li a"
    },
    "video": "//video/@src",
    "search": {
      "list": "$.list",
      "id": "$.id",
      "title": "$.name",
      "cover": "$.pic"
    },
    "category": {
      "list": "$.list",
      "id": "$.vod_id",
      "title": "$.vod_name",
      "cover": "$.vod_pic",
      "description": "$.vod_remarks"
    }
  },
  "category": {
    "dynamicCategories": false,
    "categoryEntries": [
      {
        "id": "1",
        "title": "连载新番"
      },
