      }
    ]
  },
  "homeSections": [
    {
      "id": "latest",
      "title": "最新更新",
      "route": "latest",
      "style": "grid",
      "limit": 18,
      "more": true
    }
  ],
  "stealthMode": true,
  "antiHotlinking": {
    "referer": "https://anime.xifanacg.com"
  },
  "ageRating": "general",
  "enabled": true,
  "enabledExplore": true,
  "isHidden": false,
  "migrationMessage": "v3：新增分类（连载新番/完结旧番/剧场版/美漫）与筛选（类型/年份/排序，走 ds_api vod 接口）。v2：搜索改走 suggest 联想接口（ajax/data 的 wd 参数无效，恒返回最新列表）；suggest 忽略 page/offset，单页 limit=50，极端多结果时翻页会重复。播放页 player_aaaa.url 为明文直链（encrypt=0）。域名由 dm.xifanacg.com 301 迁移至 anime.xifanacg.com。",
