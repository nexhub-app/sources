{
  "id": "pms_age",
  "version": 3,
  "name": "Age动漫",
  "type": "animeSource",
  "responseType": "html",
  "useWebview": false,
  "site": {
    "domain": "www.agedm.io",
    "baseUrl": "https://www.agedm.io",
    "mirrors": [
      {
        "name": "主站",
        "domain": "www.agedm.io",
        "baseUrl": "https://www.agedm.io"
      }
    ]
  },
  "parser": {
    "type": "hybrid",
    "overrides": {
      "latest": {
        "type": "builtin"
      },
      "search": {
        "type": "builtin"
      },
      "detail": {
        "type": "builtin"
      },
      "episodes": {
        "type": "builtin"
      },
      "video": {
        "type": "webview",
        "script": "(function(){try{var h=document.documentElement.outerHTML;var host=location.host||'';if(host.indexOf('agedm')===-1){var m=h.indexOf('.m3u8');if(m>=0){var a=h.lastIndexOf('http',m);if(a>=0&&a<m){var e=a;while(e<h.length){var c=h.charCodeAt(e);if(c===34||c===39||c===60||c===62||c===32||c===10||c===13||c===9)break;e++;}var u=h.substring(a,e);if(u.indexOf('.m3u8')>=0)return u;}}var v=document.querySelector('video');if(v&&v.src)return v.src;var s=document.querySelector('source');if(s&&s.src)return s.src;return '';}var f=document.getElementById('iframeForVideo');if(!f){var fl=document.getElementsByTagName('iframe');for(var i=0;i<fl.length;i++){var sc=fl[i].getAttribute('src')||'';if(sc.indexOf('url=')>=0){f=fl[i];break;}}}if(f){var su=f.getAttribute('src')||f.src||'';if(su.indexOf('http')===0)return 'webview:'+su;}return '';}catch(e){return '';}})();"
      }
    }
  },
  "routes": {
    "latest": {
      "url": "/recommend/{page}",
      "method": "get",
      "responseType": "html"
    },
    "search": {
      "url": "/search?query={keyword}&page={page}",
      "method": "get",
      "responseType": "html"
    },
    "detail": {
      "url": "{detailUrl}",
      "method": "get",
      "responseType": "html"
    },
    "episodes": {
      "url": "{detailUrl}",
      "method": "get",
      "responseType": "html"
    },
    "video": {
      "url": "{url}",
      "method": "get",
      "responseType": "html"
    },
    "category": {
      "url": "/catalog/{type}-{year}-{letter}-{class}-{version}-{sort}-{page}-{region}-{month}-{status}",
      "method": "get",
      "responseType": "html"
    }
  },
  "selectors": {
    "latest": {
      "list": "div.video_list_box--bd div.video_item",
      "id": "a@href",
      "title": "a",
      "cover": "img@data-original",
      "description": "span.video_item--info"
    },
    "search": {
      "list": "div.card.cata_video_item",
      "id": "a@href",
      "title": "h5.card-title",
      "cover": "img.video_thumbs@data-original"
    },
    "detail": {
      "title": "div.video_detail_right h2",
      "cover": "div.video_detail_cover img@data-original",
      "description": "div.video_detail_desc"
    },
    "episodes": {
      "lineList": "div.tab-pane",
      "lineName": "ul.nav.nav-pills li",
      "list": "ul.video_detail_episode li a"
    },
    "category": {
      "list": "div.card.cata_video_item",
      "id": "a@href",
      "title": "h5.card-title",
      "cover": "img.video_thumbs@data-original"
    }
  },
  "category": {
    "dynamicCategories": false,
    "categoryEntries": [
      {
        "id": "all",
        "title": "全部"
      },
      {
        "id": "TV",
        "title": "TV"
      },
      {
        "id": "剧场版",
        "title": "剧场版"
      },
      {
        "id": "OVA",
        "title": "OVA"
      }
    ]
  },
  "homeSections": [
    {
      "id": "latest",
      "title": "今日推荐",
      "route": "latest",
      "style": "grid",
      "limit": 18,
      "more": true
    }
  ],
  "stealthMode": true,
  "antiHotlinking": {
    "referer": "https://www.agedm.io"
  },
  "ageRating": "general",
  "enabled": true,
  "enabledExplore": true,
  "isHidden": false,
  "migrationMessage": "v3：修复分类列表选择器（目录页条目为 div.card.cata_video_item，与搜索页一致；推荐页的 video_list_box 结构不适用于 /catalog）。v2：新增分类（全部/TV/剧场版/OVA）与九维筛选（版本/年份/首字母/类型/资源/排序/地区/季度/状态，走 /catalog 十段路径路由，未选维度以 all 兜底）。v1：初版；播放走 WebView 抽取解析站直链。",
