        "type": "script",
        "script": "function folders(raw, context){try{var base=(context&&typeof context.baseUrl==='string'&&context.baseUrl)?context.baseUrl:'https://hanime1.me';if(typeof raw!=='string'||!raw)return [];var m=raw.match(/<a[^>]*id=\"user-modal-trigger\"[^>]*>/i);var uid='';if(m){var hm=m[0].match(/href=\"([^\"]*)\"/i);if(hm){var pm=hm[1].match(/\\/user\\/(\\d+)/);if(pm)uid=pm[1];}}if(!uid)return [];return [{title:'喜歡的影片',url:base+'/user/'+uid+'/likes',value:'likes',count:0},{title:'稍後再看',url:base+'/user/'+uid+'/saves',value:'saves',count:0}];}catch(e){return [];}}"
