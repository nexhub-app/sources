      "favList": {
        "type": "script",
        "script": "function favList(raw, context){try{var base=(context&&typeof context.baseUrl==='string'&&context.baseUrl)?context.baseUrl:'https://hanime1.me';if(typeof raw!=='string'||!raw)return [];function abs(h){if(!h)return '';if(h.indexOf('http')===0)return h;if(h.indexOf('/')===0)return base+h;return base+'/'+h;}var block=raw;var hm=block.match(/<div[^>]*class=\"horizontal-row\"/i);if(hm)block=raw.slice(hm.index);var positions=[];var re=/<div[^>]*class=\"user-tab-item-wrapper[^\"]*\"/gi;var m;while((m=re.exec(block)))positions.push(m.index);if(!positions.length)return [];var cards=[];for(var i=0;i<positions.length;i++){var seg=block.slice(positions[i],i+1<positions.length?positions[i+1]:block.length);var am=seg.match(/href=\"([^\"]*watch[^\"]*)\"/i);if(!am)continue;var href=abs(am[1].replace(/&amp;/g,'&'));var cm=href.match(/watch\\?v=(\\d+)/);if(!cm)continue;var tm=seg.match(/<h4[^>]*class=\"video-title\"[^>]*>([\\s\\S]*?)<\\/h4>/i)||seg.match(/<div[^>]*class=\"title\"[^>]*>([\\s\\S]*?)<\\/div>/i);var title=tm?tm[1].replace(/<[^>]+>/g,'').replace(/\\s+/g,' ').trim():'';var ivm=seg.match(/<img[^>]*src=\"([^\"]+)\"/i);var cover=ivm?abs(ivm[1].replace(/&amp;/g,'&')):'';cards.push({id:cm[1],title:title||'未命名',cover:cover,detailUrl:href});}return cards;}catch(e){return [];}}"
