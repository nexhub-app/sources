      "video": {
        "type": "script",
        "script": "function video(raw, context){try{var org='https://hanime1.me';var cu=(context&&typeof context.url==='string')?context.url:'';var om=cu.match(/^(https?:\\/\\/[^\\/]+)/);if(om)org=om[1];function abs(u){if(!u)return '';u=String(u).trim();if(!u)return '';if(u.indexOf('//')===0)return 'https:'+u;if(u.indexOf('http://')===0||u.indexOf('https://')===0)return u;if(u.charAt(0)==='/')return org+u;return org+'/'+u;}var seg=(typeof raw==='string')?raw:'';var vm=seg.match(/<video[^>]*id=[\"']player[\"'][^>]*>([\\s\\S]*?)<\\/video>/i);if(vm)seg=vm[1];var list=[];var re=/<source\\b[^>]*>/gi;var m;while((m=re.exec(seg))){var tag=m[0];var sm=tag.match(/src\\s*=\\s*[\"']([^\"']+)[\"']/i);if(!sm)continue;var s=abs(sm[1]);if(!s)continue;if(!vm&&s.indexOf('.mp4')<0&&s.indexOf('.m3u8')<0)continue;var zm=tag.match(/size\\s*=\\s*[\"']([^\"']+)[\"']/i);var n=zm?zm[1].replace(/[^0-9]/g,''):'';var p=parseInt(n,10);if(isNaN(p))p=0;var nm=n?(n+'P'):'正片';list.push({url:s,size:p,name:nm});}if(!list.length){var cm=raw?raw.match(/const source\\s*=\\s*['\"]([^'\"]+)['\"]/):null;if(cm){var s2=abs(cm[1]);if(s2)list.push({url:s2,size:0,name:'正片'});}}if(!list.length){var pm=raw?raw.match(/<video[^>]*\\ssrc\\s*=\\s*[\"']([^\"']+)[\"']/i):null;if(pm){var s3=abs(pm[1]);if(s3)list.push({url:s3,size:0,name:'正片'});}}if(!list.length)return {url:'',type:'mp4',urls:[]};list.sort(function(a,b){return b.size-a.size;});var t=list[0].url.indexOf('.m3u8')>=0?'m3u8':'mp4';return {url:list[0].url,type:t,urls:list.map(function(e){return {name:e.name,url:e.url};})};}catch(e){return {url:'',type:'mp4',urls:[]};}}"
